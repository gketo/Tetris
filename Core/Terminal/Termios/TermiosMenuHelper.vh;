#pragma once

#include "Core/Terminal/ITerminalCore.h"
#include "Core/Menu/MenuData.h"
#include "Core/Terminal/Termios/TermiosUtils.h"
#include "Core/Graphics/GfxUtils.h"

#include <cstddef>
#include <string>
#include <string_view>

namespace Core::Terminal::Termios {

    namespace GfxUtils = Core::Graphics::Utils;
    namespace TermiosUtils = Core::Terminal::Termios::Utils;

    struct TermiosMenuHelper
    {
    public:
        // returns menu as terminal printable string
        static std::string toString(const Core::Terminal::ITerminalCore& terminal, const MenuData& menuData);

    private:
        static void appendColored(std::string& out, std::string_view text, GfxUtils::Color color);
    };

    std::string TermiosMenuHelper::toString(const Core::Terminal::ITerminalCore& terminal, const MenuData& menuData)
    {
        std::string frameStr; 

        TermiosUtils::appendHideCursor(frameStr);
        TermiosUtils::appendCursorHome(frameStr);

        // get windows size 
        auto termConfig = terminal.getTerminalConfig();
        auto winWidth = termConfig.size.width;

        int row{ 0 };

        // if welcome msg is too long we wrap it vertically
        frameStr += TermiosUtils::ERASE_LINE_TORIGHT;
        for (const auto& line : TermiosUtils::wrap(menuData.welcomeMsg, winWidth))
        {
            frameStr += line;
            ++row;
            TermiosUtils::appendMoveCursorTerminalSafe(frameStr, termConfig, row, 0);
            frameStr += TermiosUtils::ERASE_LINE_TORIGHT;
        }

        ++row;
        TermiosUtils::appendMoveCursorTerminalSafe(frameStr, termConfig, row, 0);
        frameStr += TermiosUtils::ERASE_LINE_TORIGHT;

        for (size_t i = 0; i < menuData.size(); ++i)
        {    
            const auto& entry = menuData.entries()[i];
            if (menuData.isHighlighted(i))
            {
                appendColored(frameStr, entry.name, GfxUtils::Color::BRIGHT_ORANGE);
            }
            else
            {
                frameStr += entry.name;
            }

            ++row;
            TermiosUtils::appendMoveCursorTerminalSafe(frameStr, termConfig, row, 0);
            frameStr += TermiosUtils::ERASE_LINE_TORIGHT;
        }

        // if commands message too long we wrap it
        frameStr += TermiosUtils::ERASE_LINE_TORIGHT;
        for (const auto& line : TermiosUtils::wrap(menuData.commandsMsg, winWidth))
        {
            frameStr += line;
            ++row;
            TermiosUtils::appendMoveCursorTerminalSafe(frameStr, termConfig, row, 0);
            frameStr += TermiosUtils::ERASE_LINE_TORIGHT;
        }

        // for every other line in window erase
        frameStr += TermiosUtils::ERASE_SCREEN_TOBOTTOM;

        frameStr += TermiosUtils::RESET_ATTRS;
        frameStr += TermiosUtils::RESET_COLORS;
        TermiosUtils::appendCursorHome(frameStr);

        return frameStr;
    }

    void TermiosMenuHelper::appendColored(std::string& out, std::string_view text, GfxUtils::Color color)
    {
        out += TermiosUtils::Termios_FgColorToAnsi(color);
        out += text;
        out += TermiosUtils::Termios_FgColorToAnsi(GfxUtils::Color::Fg_Default);
    }
}